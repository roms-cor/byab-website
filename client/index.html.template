<!DOCTYPE html>
<html lang="{{SITE_LOCALE}}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{SITE_TITLE}}</title>
    <meta name="description" content="{{SITE_DESCRIPTION}}" />
    <meta name="keywords" content="{{SITE_KEYWORDS}}" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="{{SITE_NAME}} ({{SITE_SHORT_NAME}})" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{SITE_NAME}}" />
    <meta property="og:title" content="{{SITE_TITLE}}" />
    <meta property="og:description" content="{{SITE_DESCRIPTION}}" />
    <meta property="og:locale" content="{{SITE_LOCALE_OG}}" />
    <meta property="og:locale:alternate" content="{{SITE_ALT_LOCALE_OG}}" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{SITE_TITLE}}" />
    <meta name="twitter:description" content="{{SITE_DESCRIPTION}}" />
    <meta name="twitter:image" content="{{SITE_OG_IMAGE}}" />
    <meta property="og:url" content="{{SITE_URL}}" />
    <meta property="og:image" content="{{SITE_OG_IMAGE}}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="theme-color" content="{{SITE_THEME_COLOR}}" />
    <link rel="canonical" href="{{SITE_URL}}" />
    {{HREFLANG_LINKS}}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap" rel="stylesheet" /></noscript>
    <link rel="preload" as="image" type="image/webp" href="/images/logo-horizontal-white.webp" />
    <link rel="preload" as="image" type="image/webp" href="{{TEAM_PRELOAD_IMAGE}}" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "#organization",
      "name": "{{SITE_NAME}}",
      "alternateName": [{{ORG_ALTERNATE_NAMES_JSONLD}}],
      "description": "{{SITE_NAME}} is an operations, transformation, and growth consultancy founded in April 2005. We externalize what buries you — admin, finance, data, and growth — so founders and managing partners can lead. 57% operating profitability, 0€ external debt raised, 20+ years of uninterrupted service.",
      "foundingDate": "{{SITE_FOUNDING_DATE}}",
      "url": "{{SITE_URL}}",
      "areaServed": [
        {{AREA_SERVED_JSONLD}}
      ],
      "knowsLanguage": ["fr", "en"],
      "sameAs": [
        {{ORG_SAMEAS_JSONLD}}
      ],
      "founder": {{TEAM_JSONLD_FOUNDER}},
      "member": [
        {{TEAM_JSONLD_MEMBERS}}
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "@id": "#service",
      "name": "{{SITE_NAME}}",
      "alternateName": "{{SITE_SHORT_NAME}}",
      "description": "{{SITE_NAME}} provides externalized operations, transformation consulting, and growth engineering for founders and managing partners since April 2005. 57% operating profitability, 0€ external debt, 20+ years of uninterrupted service.",
      "foundingDate": "{{SITE_FOUNDING_DATE}}",
      "url": "{{SITE_URL}}",
      "email": "{{SITE_EMAIL}}",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "{{SITE_ADDRESS_STREET}}",
        "addressLocality": "{{SITE_ADDRESS_CITY}}",
        "postalCode": "{{SITE_ADDRESS_POSTAL}}",
        "addressCountry": "{{SITE_ADDRESS_COUNTRY_CODE}}"
      },
      "areaServed": [
        {{AREA_SERVED_JSONLD}}
      ],
      "priceRange": "$$",
      "serviceType": [
        "Externalized Operations",
        "General Secretariat",
        "Transformation & Data Consulting",
        "Growth Engineering",
        "B2B Outbound",
        "Legal Practice Operations",
        "Law Firm Administration"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "{{SITE_NAME}} Services",
        "itemListElement": [
          {{SERVICES_OFFER_JSONLD_ENTITIES}}
        ]
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5",
        "reviewCount": "1"
      }
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "{{SITE_NAME}}",
      "alternateName": "{{SITE_SHORT_NAME}}",
      "url": "{{SITE_URL}}",
      "description": "{{SITE_NAME}} — operations, transformation, and growth consultancy for founders and managing partners since 2005.",
      "inLanguage": ["en", "fr"]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {{FAQ_JSONLD_ENTITIES}}
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{SITE_URL}}" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "{{SITE_URL}}#services" },
        { "@type": "ListItem", "position": 3, "name": "Track Record", "item": "{{SITE_URL}}#work" },
        { "@type": "ListItem", "position": 4, "name": "Team", "item": "{{SITE_URL}}#team" },
        { "@type": "ListItem", "position": 5, "name": "Story", "item": "{{SITE_URL}}#story" },
        { "@type": "ListItem", "position": 6, "name": "FAQ", "item": "{{SITE_URL}}#faq" },
        { "@type": "ListItem", "position": 7, "name": "Contact", "item": "{{SITE_URL}}#contact" }
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SiteNavigationElement",
      "name": "Main Navigation",
      "hasPart": [
        {
          "@type": "SiteNavigationElement",
          "name": "Services",
          "description": "Four service pillars: operational backbone, transformation & data, growth engine, and legal practice ops",
          "url": "{{SITE_URL}}#services"
        },
        {
          "@type": "SiteNavigationElement",
          "name": "Track Record",
          "description": "Recent client engagements and measurable outcomes across B2B SaaS, law firms, and tech SMEs",
          "url": "{{SITE_URL}}#work"
        },
        {
          "@type": "SiteNavigationElement",
          "name": "Team",
          "description": "Four complementary specialists: operations, transformation & data, growth, and founding coordination since 2005",
          "url": "{{SITE_URL}}#team"
        },
        {
          "@type": "SiteNavigationElement",
          "name": "Story",
          "description": "Company history from {{FOUNDING_YEAR}} founding by {{FOUNDER_NAME}} to the current {{TEAM_COUNT_WORD}}-person consultancy",
          "url": "{{SITE_URL}}#story"
        },
        {
          "@type": "SiteNavigationElement",
          "name": "FAQ",
          "description": "Frequently asked questions — who we are, services, founders, locations, track record, and how we differ",
          "url": "{{SITE_URL}}#faq"
        },
        {
          "@type": "SiteNavigationElement",
          "name": "Contact",
          "description": "Get in touch — email {{SITE_EMAIL}}, based in {{SITE_LOCATIONS_PROSE}}, 24-hour response",
          "url": "{{SITE_URL}}#contact"
        }
      ]
    }
    </script>
  </head>
  <body>
    <div id="root"><!--ssr-outlet--></div>
    <script type="module" src="/src/main.tsx"></script>
  </body>
</html>
